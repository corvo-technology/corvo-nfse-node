{
  "name": "corvo-nfse-node",
  "version": "0.1.0",
  "description": "SDK Node.js + CLI for the Corvo NFS-e API (self-hosted)",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18.0.0" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "bin": { "corvo": "./bin/corvo" },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "clean": "rm -rf dist"
  },
  "dependencies": { "commander": "^13.1.0" },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "keywords": ["corvo", "nfse", "nota fiscal", "sdk", "cli", "api"],
  "repository": {
    "type": "git",
    "url": "https://github.com/corvo-technology/corvo-nfse-node.git"
  }
}
